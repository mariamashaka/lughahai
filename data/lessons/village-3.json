    {
      "who": "anna",
      "say": {
        "sw": "Tazama: Nina kiu, Nina njaa. Maneno yote mawili huanza na Nina. Unaweza kusema Nina na kitu kingine pia.",
        "en": "Look: Nina kiu, Nina njaa. Both start with Nina (\"I have\"). You can say Nina and other things too."
      }
    },
    {
      "who": "anna",
      "say": {
        "sw": "Hii ni nini? ni swali. Unaweza kuuliza hivyo kuhusu kila kitu unachokiona.",
        "en": "Hii ni nini? is a question. You can ask it about anything you see."
      }
    },
    {
      "who": "anna",
      "say": {
        "sw": "Ili kuendelea, lazima ukariri maneno haya. Sasa tutafanya mazoezi.",
        "en": "To go on, you need to memorise these words. Now we will practise."
      }
    }
