    {
      "who": "anna",
      "say": {
        "sw": "Tazama: Nina kiu, Nina njaa, Nina usingizi. Kila mara huanza na Nina. Hivi ndivyo unavyosema unavyohisi.",
        "en": "Look: Nina kiu, Nina njaa, Nina usingizi. Every time it starts with Nina. This is how you say how you feel."
      },
      "npc": "anna"
    },
    {
      "who": "anna",
      "say": {
        "sw": "Siku ya 1 imeisha. Kesho ni siku mpya.",
        "en": "Day 1 is over. Tomorrow is a new day."
      }
    },
    {
      "who": "anna",
      "say": {
        "sw": "Ili kuendelea, lazima ukariri maneno haya. Sasa tutafanya mazoezi.",
        "en": "To go on, you need to memorise these words. Now we will practise."
